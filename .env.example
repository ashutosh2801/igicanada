APP_NAME="IGI Canada"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
PUBLIC_STORAGE_URL=/storage
WHOLESALE_DOMAIN=igicanada.ca
WHOLESALE_DOMAIN_ALIASES=www.igicanada.ca
RETAIL_DOMAIN=leatherwallets.ca
RETAIL_DOMAIN_ALIASES=www.leatherwallets.ca
# Set this to igicanada.ca in production. Leaving it empty keeps /admin available on localhost.
ADMIN_DOMAIN=
STOREFRONT_DEFAULT_CHANNEL=wholesale
RETAIL_GST_HST_REGISTERED=false
RETAIL_GST_HST_NUMBER=
RETAIL_TAX_REVIEWED=false
SHIPPING_RATES_REVIEWED=false
RETAIL_LEGAL_REVIEWED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=igicanada
DB_USERNAME=root
DB_PASSWORD=

# Read-only connection used only by repeatable legacy migration commands.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=leatherwallets
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
COMMERCE_COMPANY_NAME="IGI Canada"
COMMERCE_COMPANY_ADDRESS="966 Pantera Dr., Unit 7"
COMMERCE_COMPANY_CITY="Mississauga, ON L4W 2S1"
COMMERCE_COMPANY_COUNTRY="Canada"
COMMERCE_COMPANY_PHONE="905-625-8831"
COMMERCE_COMPANY_EMAIL="newigi@gmail.com"
COMMERCE_ORDER_EMAIL="newigi@gmail.com"
CANADA_POST_ENABLED=false
CANADA_POST_ENVIRONMENT=sandbox
CANADA_POST_API_KEY=
CANADA_POST_API_SECRET=
CANADA_POST_CUSTOMER_NUMBER=
CANADA_POST_CONTRACT_ID=
